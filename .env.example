# ── Copy to .env (never commit) ──────────────────────────────────────────────
# VPS stack
QDRANT_API_KEY=change-me-long-random
FACTSTORE_USER=factstore
FACTSTORE_PASSWORD=change-me-long-random
QDRANT_DOMAIN=qdrant.example.com        # only for: --profile edge

# Pipeline (also set as GitHub secrets/vars on the central docs repo)
INTERNAL_AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com   # or http://ollama:11434 for a local server
AI_API_PATH=/v1/chat/completions
AI_MODEL=gpt-4o
AI_FAST_MODEL=gpt-4o-mini
AI_EMBED_MODEL=text-embedding-3-small
AI_EMBED_DIM=1536                        # MUST match the embedding model; changing it needs a new collection

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs_chunks
FACTSTORE_DATABASE_URL=postgres://factstore:change-me@localhost:5432/factstore

# Decision thresholds (defaults shown)
MIN_DIFF_LINES=3
SIMILARITY_HIGH=0.92
PRECISION_MIN=0.9
RECALL_MIN=0.8
STYLE_MIN=0.7
JUDGE_MIN=0.75
MAX_ITERATIONS=3

# Fallback alerting (all optional)
TICKET_PROVIDER=caimandesk               # caimandesk | github | jira | none
CAIMANDESK_URL=https://tickets.caimanlabs.com.mx
CAIMANDESK_API_TOKEN=                    # cAImanDesk > Settings > API tokens (permission: create tasks)
CAIMANDESK_PROJECT_ID=                   # numeric id of the project that receives docs-sync tickets
SLACK_WEBHOOK_URL=
