# ── Copy to .env (never commit) ──────────────────────────────────────────────
# VPS stack
QDRANT_API_KEY=change-me-long-random     # leave empty if Qdrant has no auth (cluster-internal)
FACTSTORE_USER=factstore
FACTSTORE_PASSWORD=change-me-long-random
QDRANT_DOMAIN=qdrant.example.com        # only for: --profile edge
QDRANT_PORT=6333                         # host ports for the compose stack (change if taken)
POSTGRES_PORT=5432

# Pipeline (also set as GitHub secrets/vars on the central docs repo)
INTERNAL_AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com   # or http://ollama:11434 for a local server
AI_API_PATH=/v1/chat/completions
# Model tiers (multisync/router.py). Expensive = OpenAI, cheap = DeepSeek; embeddings are always OpenAI.
AI_EXPENSIVE_MODEL=gpt-5.6-terra
AI_CHEAP_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
# ROUTER_FORCE=auto   (auto|cheap|expensive)
# ROUTER_JUDGE=expensive   (expensive|cheap|follow)
AI_EMBED_MODEL=text-embedding-3-small
AI_EMBED_DIM=1536                        # MUST match the embedding model; changing it needs a new collection

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs_chunks            # semantic context: approved pages, source docs, page briefs
QDRANT_CODE_COLLECTION=code_context      # code context: every in-scope source file
FACTSTORE_DATABASE_URL=postgres://factstore:change-me@localhost:5432/factstore   # all tables live in the `multisync` schema

# Decision thresholds (defaults shown)
MIN_DIFF_LINES=3
SIMILARITY_HIGH=0.92
PRECISION_MIN=0.9
RECALL_MIN=0.85
CORE_RECALL_MIN=1                        # every fact the judge marks core must be covered
STYLE_MIN=0.7
JUDGE_MIN=0.75
MAX_ITERATIONS=3
CODE_TOP_K=12                            # code chunks retrieved from the whole repo (30 on the widened retry)
CODE_TOP_K_WIDENED=30
CONTEXT_BUDGET_CHARS=30000
CONTEXT_MIN_SCORE=0.45                   # retrieved chunks below this cosine similarity are dropped (page briefs are always kept)

# Fallback alerting (all optional)
TICKET_PROVIDER=caimandesk               # caimandesk | github | jira | none
CAIMANDESK_URL=https://tickets.caimanlabs.com.mx
CAIMANDESK_API_TOKEN=                    # cAImanDesk > Settings > API tokens (permission: create tasks)
CAIMANDESK_PROJECT_ID=                   # numeric id of the project that receives docs-sync tickets
CAIMANDESK_TRANSPORT=mcp                 # mcp (Vikunja built-in MCP, default) | rest (Vikunja API); same API token for both
CAIMANDESK_MCP_URL=                      # default: <CAIMANDESK_URL>/api/v2/mcp
CAIMANDESK_PUBLIC_URL=                   # links in tickets; set when CAIMANDESK_URL is the in-cluster address
SLACK_WEBHOOK_URL=
